---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { firma } from '../data/firma';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PozoviDugme from '../components/PozoviDugme.astro';
import { schemaMrvice, type Mrvica } from '../data/schema';
import { nadjiPar, jezikPutanje } from '../data/jezici';

interface Props {
  title: string;
  description: string;
  slika?: string;
  schema?: object[];
  mrvice?: Mrvica[];
  noindex?: boolean;
}

const { title, description, slika, schema = [], mrvice, noindex } = Astro.props;
const jezik = jezikPutanje(Astro.url.pathname);
const alternativa = nadjiPar(Astro.url.pathname);
const sveSheme = mrvice && mrvice.length > 1 ? [...schema, schemaMrvice(mrvice)] : schema;
---

<!doctype html>
<html lang={jezik === 'en' ? 'en' : 'sr-Latn'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#d3121e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo title={title} description={description} slika={slika} schema={sveSheme} noindex={noindex} jezik={jezik} alternativa={alternativa} />
    {
      firma.googleTag && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${firma.googleTag}`}></script>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
          </script>
        </>
      )
    }
    {firma.umamiId && (
      <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={firma.umamiId} data-domains="slepstojanovic.rs,www.slepstojanovic.rs"></script>
    )}
    <script is:inline>
      // Klikovi na Pozovi / Viber / WhatsApp: broji Umami, a šalje se i Google tagu (dataLayer, događaj "kontakt_klik").
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var h = a.getAttribute('href');
        var ime = h.indexOf('tel:') === 0 ? 'Poziv' : h.indexOf('viber:') === 0 ? 'Viber' : h.indexOf('wa.me') !== -1 ? 'WhatsApp' : null;
        if (!ime) return;
        if (window.umami) window.umami.track(ime, { stranica: location.pathname });
        if (window.dataLayer) window.dataLayer.push({ event: 'kontakt_klik', kanal: ime, stranica: location.pathname });
      });
    </script>
  </head>
  <body>
    <a href="#sadrzaj" class="skriveno">{jezik === 'en' ? 'Skip to content' : 'Preskoči na sadržaj'}</a>
    <Header jezik={jezik} drugiJezik={alternativa ? (jezik === 'en' ? alternativa.sr : alternativa.en) : jezik === 'en' ? '/' : '/en'} />
    <main id="sadrzaj">
      <slot />
    </main>
    <Footer jezik={jezik} />
    <PozoviDugme jezik={jezik} />
  </body>
</html>
