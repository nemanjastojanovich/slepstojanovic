---
import { Image } from 'astro:assets';
import Osnovni from '../layouts/Osnovni.astro';
import KontaktDugmad from '../components/KontaktDugmad.astro';
import CtaTraka from '../components/CtaTraka.astro';
import Faq from '../components/Faq.astro';
import Ikonica from '../components/Ikonica.astro';
import { firma } from '../data/firma';
import { usluge } from '../data/usluge';
import { lokacije } from '../data/lokacije';
import { slike, galerija } from '../data/slike';
import { pitanjaOpsta } from '../data/pitanja';
import { schemaFirma, schemaPitanja } from '../data/schema';

const prednosti = [
  { ikona: 'sat', naslov: '0–24h, svaki dan', tekst: 'Radimo danju i noću, vikendom i praznicima.' },
  { ikona: 'lokacija', naslov: 'Lokalno iz Banovaca', tekst: 'Polazimo iz Starih Banovaca – blizu Pazove, Batajnice i autoputa.' },
  { ikona: 'kamion', naslov: 'Srbija i Evropa', tekst: 'Osim lokalnog šlepa, prevozimo vozila po celoj Srbiji i Evropi.' },
  { ikona: 'viber', naslov: 'Viber i WhatsApp', tekst: 'Pošaljite lokaciju i slike vozila – brže se dogovaramo.' },
] as const;

const koraci = [
  { naslov: 'Pozovite nas', tekst: `Na ${firma.telefon} ili preko Vibera i WhatsApp-a. Recite gde ste i šta se desilo.` },
  { naslov: 'Dogovorimo prevoz', tekst: 'Kažete nam kuda vozilo treba da ide – servis, kuća ili druga adresa.' },
  { naslov: 'Dolazimo i prevozimo', tekst: 'Utovarujemo vozilo na platformu i bezbedno ga prevozimo do cilja.' },
];

const grupe = ['Srem', 'Beograd', 'Autoput'] as const;
---

<Osnovni
  title="Šlep služba Stari Banovci 0–24h | Šlep Stojanović – Srem i Beograd"
  description="Šlep služba i pomoć na putu 0–24h iz Starih Banovaca: Pazova, Batajnica, Zemun, Beograd, Inđija. Prevoz vozila po Srbiji i Evropi. Pozovite 063 55 85 81."
  schema={[schemaFirma(), schemaPitanja(pitanjaOpsta)]}
>
  <section class="hero">
    <div class="kontejner hero__red">
      <div class="hero__tekst">
        <p class="hero__nadnaslov">Šlep Stojanović · Stari Banovci</p>
        <h1>Šlep služba i pomoć na putu <span>0–24h</span></h1>
        <p class="hero__opis">
          Šlepanje putničkih vozila, transport tereta, građevinskih mašina i ostale mehanizacije, prevoz traktora  i poljoprivrednih mašina,  prevoz vozila iz inostranstva - Evrope. Dolazimo na vašu lokaciju u rekordnom roku.
        </p>
        <KontaktDugmad svetla />
      </div>
      <div class="hero__slika">
        <Image src={slike.automobil.src} alt={slike.automobil.alt} widths={[480, 800, 1200]} sizes="(min-width: 860px) 50vw, 100vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="sekcija">
    <div class="kontejner mreza prednosti">
      {
        prednosti.map((p) => (
          <div class="prednost">
            <span class="prednost__ikona"><Ikonica ime={p.ikona} /></span>
            <h2 class="h3">{p.naslov}</h2>
            <p>{p.tekst}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="sekcija sekcija--siva" id="usluge">
    <div class="kontejner">
      <h2 class="naslov-sekcije">Naše usluge</h2>
      <div class="mreza">
        {
          usluge.map((u) => (
            <article class="kartica">
              <h3>{u.naziv}</h3>
              <p>{u.kratko}</p>
              <a class="vise" href={`/usluge/${u.slug}`}>Saznajte više →</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sekcija">
    <div class="kontejner">
      <h2 class="naslov-sekcije">Kako radimo</h2>
      <ol class="koraci">
        {
          koraci.map((k) => (
            <li>
              <h3>{k.naslov}</h3>
              <p>{k.tekst}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="sekcija sekcija--siva" id="oblast-rada">
    <div class="kontejner dve-kolone">
      <div>
        <h2 class="naslov-sekcije">Gde radimo</h2>
        <p class="podnaslov">
          Sedište nam je u Starim Banovcima. Pokrivamo celu okolinu Banovaca i Beograd, a vozila prevozimo i po celoj
          Srbiji i Evropi.
        </p>
        {
          grupe.map((g) => (
            <div class="grupa">
              <h3>{g === 'Autoput' ? 'Autoput' : g}</h3>
              <ul class="oznake">
                {lokacije
                  .filter((l) => l.grupa === g)
                  .map((l) => (
                    <li>
                      <a href={`/lokacije/${l.slug}`}>{l.mesto}</a>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="mapa">
        <iframe
          title="Mapa – Šlep Stojanović, Stari Banovci"
          src={firma.googleMapaEmbed(120000)}
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <section class="sekcija">
    <div class="kontejner">
      <h2 class="naslov-sekcije">Sa terena</h2>
      <div class="galerija-mala">
        {galerija.slice(0, 3).map((s) => <Image src={s.src} alt={s.alt} widths={[400, 700]} sizes="(min-width: 860px) 33vw, 100vw" class="zaobljena" />)}
      </div>
      <p style="margin-top:20px"><a class="dugme dugme--obrub" href="/galerija">Pogledajte galeriju</a></p>
    </div>
  </section>

  <section class="sekcija recenzije">
    <div class="kontejner recenzije__red">
      <div>
        <h2 class="naslov-sekcije">Šta kažu naši klijenti</h2>
        <p class="podnaslov">
          Pročitajte utiske klijenata na našem Google profilu. Ako ste već koristili našu uslugu, biće nam drago da
          ostavite recenziju – tako i drugi vozači lakše nađu pouzdanu šlep službu.
        </p>
      </div>
      <div class="dugmad">
        <a class="dugme dugme--obrub" href={firma.mreze.googleMape} rel="noopener" target="_blank">★ Pogledajte recenzije</a>
        <a class="dugme dugme--crveno" href={firma.mreze.googleRecenzija} rel="noopener" target="_blank">Ostavite recenziju</a>
      </div>
    </div>
  </section>

  <section class="sekcija sekcija--siva">
    <div class="kontejner" style="max-width:820px">
      <Faq pitanja={pitanjaOpsta} />
      <p><a href="/cesta-pitanja">Sva pitanja →</a></p>
    </div>
  </section>

  <CtaTraka />
</Osnovni>

<style>
  .recenzije__red {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
  }
  .recenzije__red .podnaslov {
    margin: 0;
  }
  .hero {
    background: linear-gradient(120deg, var(--tamnocrvena) 0%, #2a0508 70%);
    color: var(--bela);
    padding-block: clamp(40px, 7vw, 88px);
    overflow: hidden;
  }
  .hero__red {
    display: grid;
    gap: 36px;
    align-items: center;
  }
  .hero__nadnaslov {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: #ffb3b8;
    font-size: 0.85rem;
  }
  .hero h1 span {
    color: #ff4a55;
    white-space: nowrap;
  }
  .hero__opis {
    font-size: 1.1rem;
    color: rgb(255 255 255 / 0.88);
    max-width: 560px;
    margin-bottom: 28px;
  }
  .hero__slika img {
    border-radius: var(--radius);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.4);
    border: 4px solid var(--bela);
  }
  @media (min-width: 860px) {
    .hero__red {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .prednost__ikona {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #fde7e9;
    color: var(--crvena);
    margin-bottom: 12px;
  }
  .prednost__ikona :global(svg) {
    width: 26px;
    height: 26px;
  }
  .h3 {
    font-size: 1.15rem;
  }
  .prednost p {
    color: var(--siva-tekst);
  }
  .koraci {
    list-style: none;
    counter-reset: korak;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .koraci li {
    counter-increment: korak;
    position: relative;
    padding: 24px 24px 16px 84px;
    background: var(--siva);
    border-radius: var(--radius);
  }
  .koraci li::before {
    content: counter(korak);
    position: absolute;
    left: 24px;
    top: 22px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--crvena);
    color: var(--bela);
    font-weight: 800;
    display: grid;
    place-items: center;
    font-size: 1.2rem;
  }
  .koraci p {
    color: var(--siva-tekst);
  }
  .grupa h3 {
    font-size: 1rem;
    margin: 20px 0 10px;
  }
  .oznake {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .oznake a {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--bela);
    color: var(--crna);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    border: 1px solid #e0e0e0;
  }
  .oznake a:hover {
    border-color: var(--crvena);
    color: var(--crvena);
  }
  .mapa iframe {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 0;
    border-radius: var(--radius);
    box-shadow: var(--senka);
  }
  .galerija-mala {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .galerija-mala :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }
</style>
