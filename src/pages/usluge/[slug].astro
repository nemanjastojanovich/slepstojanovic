---
import { Image } from 'astro:assets';
import Osnovni from '../../layouts/Osnovni.astro';
import HeroMali from '../../components/HeroMali.astro';
import CtaTraka from '../../components/CtaTraka.astro';
import Faq from '../../components/Faq.astro';
import { usluge, type Usluga } from '../../data/usluge';
import { lokacije } from '../../data/lokacije';
import { slike } from '../../data/slike';
import { schemaFirma, schemaUsluga, schemaPitanja } from '../../data/schema';
import { firma } from '../../data/firma';

export function getStaticPaths() {
  return usluge.map((u) => ({ params: { slug: u.slug }, props: { usluga: u } }));
}

interface Props {
  usluga: Usluga;
}

const { usluga } = Astro.props;
const url = `${firma.sajt}/usluge/${usluga.slug}`;
const slika = slike[usluga.slika];
const ostale = usluge.filter((u) => u.slug !== usluga.slug);
const mrvice = [
  { naziv: 'Početna', url: '/' },
  { naziv: 'Usluge', url: '/#usluge' },
  { naziv: usluga.naziv, url: `/usluge/${usluga.slug}` },
];
---

<Osnovni
  title={usluga.title}
  description={usluga.description}
  mrvice={mrvice}
  schema={[schemaFirma(), schemaUsluga(usluga.naziv, usluga.description, url), schemaPitanja(usluga.pitanja)]}
>
  <HeroMali naslov={usluga.h1} podnaslov={usluga.uvod} mrvice={mrvice} />

  <section class="sekcija">
    <div class="kontejner dve-kolone">
      <div>
        {
          usluga.sekcije.map((s) => (
            <>
              <h2>{s.naslov}</h2>
              {s.tekst.map((t) => <p>{t}</p>)}
            </>
          ))
        }
        <h2>{usluga.lista.naslov}</h2>
        <ul class="lista-tacke">
          {usluga.lista.stavke.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <aside>
        <Image src={slika.src} alt={slika.alt} widths={[400, 700]} sizes="(min-width: 860px) 40vw, 100vw" class="zaobljena" />
        <div class="kartica" style="margin-top:20px">
          <h3>Gde radimo</h3>
          <p>
            {lokacije.map((l, i) => (
              <><a href={`/lokacije/${l.slug}`}>{l.mesto}</a>{i < lokacije.length - 1 ? ', ' : ''}</>
            ))}
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="sekcija sekcija--siva">
    <div class="kontejner" style="max-width:820px">
      <Faq pitanja={usluga.pitanja} />
    </div>
  </section>

  <section class="sekcija">
    <div class="kontejner">
      <h2 class="naslov-sekcije">Ostale usluge</h2>
      <div class="mreza">
        {
          ostale.map((u) => (
            <article class="kartica">
              <h3>{u.naziv}</h3>
              <p>{u.kratko}</p>
              <a class="vise" href={`/usluge/${u.slug}`}>Saznajte više →</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaTraka />
</Osnovni>
