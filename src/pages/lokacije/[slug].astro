---
import Osnovni from '../../layouts/Osnovni.astro';
import HeroMali from '../../components/HeroMali.astro';
import CtaTraka from '../../components/CtaTraka.astro';
import Faq from '../../components/Faq.astro';
import { lokacije, nadjiLokaciju, type Lokacija } from '../../data/lokacije';
import { usluge } from '../../data/usluge';
import { schemaFirma, schemaUsluga, schemaPitanja } from '../../data/schema';
import { pitanjaLokacija } from '../../data/pitanjaLokacija';
import { slike } from '../../data/slike';
import { Image } from 'astro:assets';

export function getStaticPaths() {
  return lokacije.map((l) => ({ params: { slug: l.slug }, props: { lokacija: l } }));
}

interface Props {
  lokacija: Lokacija;
}

const { lokacija } = Astro.props;
const naAutoputu = lokacija.grupa === 'Autoput';
const h1 = naAutoputu ? 'Šlep služba na autoputu Beograd–Novi Sad i Beograd–Zagreb 0–24h' : `Šlep služba ${lokacija.mesto} 0–24h`;
const okolina = lokacija.okolina
  .map((m) => nadjiLokaciju(m))
  .filter((l): l is Lokacija => Boolean(l) && l?.slug !== lokacija.slug);
const pitanja = pitanjaLokacija[lokacija.slug] ?? [];
const slikeMesta = (lokacija.slike ?? []).map((k) => slike[k]);
const url = new URL(`/lokacije/${lokacija.slug}`, Astro.site ?? 'https://slepstojanovic.rs').href;
const sheme: object[] = [
  schemaFirma(),
  schemaUsluga(`Šlep služba ${lokacija.mesto}`, lokacija.description, url, [lokacija.mesto]),
];
if (pitanja.length) sheme.push(schemaPitanja(pitanja));
const mrvice = [
  { naziv: 'Početna', url: '/' },
  { naziv: 'Lokacije', url: '/lokacije' },
  { naziv: lokacija.mesto, url: `/lokacije/${lokacija.slug}` },
];
---

<Osnovni title={lokacija.title} description={lokacija.description} mrvice={mrvice} schema={sheme}>
  <HeroMali
    naslov={h1}
    podnaslov={`Šlepanje vozila i pomoć na putu ${lokacija.uMestu} – danju i noću, svakog dana.`}
    mrvice={mrvice}
  />

  <section class="sekcija">
    <div class="kontejner dve-kolone">
      <div>
        <h2>{naAutoputu ? 'Kvar na autoputu?' : `Šlep ${lokacija.uMestu}`}</h2>
        {lokacija.tekst.map((t) => <p>{t}</p>)}

        {
          slikeMesta.length > 0 && (
            <div class:list={['sa-terena', { dve: slikeMesta.length > 1 }]}>
              {slikeMesta.map((sl) => (
                <figure>
                  <Image src={sl.src} alt={sl.alt} widths={[400, 800]} sizes="(min-width: 860px) 560px, 100vw" class="zaobljena" />
                  {sl.opis && <figcaption>{sl.opis}</figcaption>}
                </figure>
              ))}
            </div>
          )
        }

        <h2>Usluge {lokacija.uMestu}</h2>
        <ul class="lista-tacke">
          {usluge.map((u) => <li><a href={`/usluge/${u.slug}`}>{u.naziv}</a> – {u.kratko}</li>)}
        </ul>
      </div>
      <aside class="kartica">
        <h3>Okolna mesta</h3>
        <ul class="lista-tacke">
          {okolina.map((l) => <li><a href={`/lokacije/${l.slug}`}>Šlep {l.mesto}</a></li>)}
        </ul>
        <p><a href="/lokacije">Sve lokacije →</a></p>
      </aside>
    </div>
  </section>

  {
    pitanja.length > 0 && (
      <section class="sekcija sekcija--siva">
        <div class="kontejner" style="max-width:820px">
          <Faq pitanja={pitanja} naslov={`Česta pitanja – ${lokacija.mesto}`} />
        </div>
      </section>
    )
  }

  <CtaTraka naslov={`Treba vam šlep ${lokacija.uMestu}?`} />
</Osnovni>

<style>
  .sa-terena {
    margin: 24px 0 8px;
    display: grid;
    gap: 20px;
  }
  .sa-terena figure {
    margin: 0;
  }
  .sa-terena :global(img) {
    width: 100%;
    height: auto;
  }
  .sa-terena figcaption {
    margin-top: 8px;
    font-size: 0.92rem;
    color: var(--siva-tekst);
  }
</style>
