---
import Osnovni from '../../layouts/Osnovni.astro';
import HeroMali from '../../components/HeroMali.astro';
import CtaTraka from '../../components/CtaTraka.astro';
import { lokacije } from '../../data/lokacije';
import { firma } from '../../data/firma';
import { schemaFirma } from '../../data/schema';
import { podrucje } from '../../data/podrucje';

const grupe = [
  { kljuc: 'Srem', naslov: 'Srem' },
  { kljuc: 'Beograd', naslov: 'Beograd' },
  { kljuc: 'Autoput', naslov: 'Autoput' },
] as const;
const mrvice = [
  { naziv: 'Početna', url: '/' },
  { naziv: 'Lokacije', url: '/lokacije' },
];
---

<Osnovni
  title="Lokacije – šlep služba u Sremu i Beogradu | Šlep Stojanović"
  description="Šlep služba za Banovce, Pazovu, Inđiju, Bešku, Simanovce, Belegiš, Surduk, Slankamen, Batajnicu, Zemun, Surčin, Novi Beograd i Beograd. 0–24h: 063 55 85 81."
  mrvice={mrvice}
  schema={[schemaFirma()]}
>
  <HeroMali
    naslov="Gde radimo"
    podnaslov="Iz Starih Banovaca pokrivamo celu okolinu Banovaca i Beograd. Vozila prevozimo i po celoj Srbiji i Evropi."
    mrvice={mrvice}
  />

  <section class="sekcija">
    <div class="kontejner">
      {
        grupe.map((g) => (
          <div class="grupa">
            <h2 class="naslov-sekcije">{g.naslov}</h2>
            <div class="mreza">
              {lokacije
                .filter((l) => l.grupa === g.kljuc)
                .map((l) => (
                  <article class="kartica">
                    <h3>Šlep {l.mesto}</h3>
                    <p>{l.tekst[0]}</p>
                    <a class="vise" href={`/lokacije/${l.slug}`}>Više o šlepu {l.uMestu} →</a>
                  </article>
                ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="sekcija sekcija--siva">
    <div class="kontejner">
      <h2 class="naslov-sekcije">Sva mesta koja pokrivamo</h2>
      <div class="sva-mesta">
        {
          podrucje.map((g) => (
            <div>
              <h3>{g.naslov}</h3>
              <p>{g.mesta.join(', ')}</p>
            </div>
          ))
        }
      </div>
      <p>Vozila po dogovoru prevozimo i po celoj Srbiji i Evropi.</p>
    </div>
  </section>

  <section class="sekcija">
    <div class="kontejner">
      <h2 class="naslov-sekcije">Mapa</h2>
      <iframe
        class="mapa"
        title="Mapa – Šlep Stojanović, Stari Banovci"
        src={firma.googleMapaEmbed(120000)}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </div>
  </section>

  <CtaTraka />
</Osnovni>

<style>
  .grupa + .grupa {
    margin-top: 48px;
  }
  .sva-mesta {
    display: grid;
    gap: 8px 32px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin-bottom: 16px;
  }
  .sva-mesta h3 {
    margin-bottom: 4px;
  }
  .mapa {
    width: 100%;
    height: 420px;
    border: 0;
    border-radius: var(--radius);
  }
</style>
