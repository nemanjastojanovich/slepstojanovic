---
import { Image } from 'astro:assets';
import Osnovni from '../../layouts/Osnovni.astro';
import HeroMali from '../../components/HeroMali.astro';
import KontaktDugmad from '../../components/KontaktDugmad.astro';
import CtaTraka from '../../components/CtaTraka.astro';
import Faq from '../../components/Faq.astro';
import { firma } from '../../data/firma';
import { slike } from '../../data/slike';
import { schemaFirma, schemaUsluga, schemaPitanja } from '../../data/schema';
import { podrucje as svaPodrucja } from '../../data/podrucje';

const usluge = [
  { naziv: 'Towing', tekst: 'Cars, vans and motorcycles – broken down or damaged in an accident – loaded onto our flatbed and taken to a garage or any address you choose.' },
  { naziv: 'Roadside assistance', tekst: 'Breakdown on the road or on the motorway, day or night. Send us your location and we come to you.' },
  { naziv: 'Machinery & classic cars', tekst: 'Tractors, farm machinery, small construction machinery and classic cars that fit on the platform, loaded and secured with care.' },
  { naziv: 'Car transport Serbia – Europe', tekst: 'Planned transport of vehicles within Serbia and to or from other European countries.', url: '/en/car-transport-europe' },
];

const podrucje = [
  'Stari and Novi Banovci',
  'Nova and Stara Pazova',
  'Batajnica, Zemun Polje, Ugrinovci',
  'Zemun, New Belgrade and the rest of Belgrade',
  'Surčin, Dobanovci and the Belgrade Airport area',
  'Inđija and the Belgrade – Novi Sad motorway',
];

const pitanja = [
  { pitanje: 'Do you speak English?', odgovor: 'Yes. You can call us or write to us in English, by phone, WhatsApp or Viber.' },
  { pitanje: 'How do I tell you where I am?', odgovor: `The easiest way is to share your live location on WhatsApp or Viber at ${firma.telefonMedjunarodni}. On the motorway, also tell us your direction (towards Belgrade or towards Novi Sad) and the nearest exit.` },
  { pitanje: 'I have insurance or an auto club membership. Can I still call you?', odgovor: 'If your insurance or auto club covers towing, check with them first, because they usually send their own partner. If you prefer to arrange towing directly, call or message us.' },
  { pitanje: 'Can you take my car to another country?', odgovor: 'Yes, by arrangement we transport vehicles within Serbia and to other European countries.' },
];

const url = new URL('/en', Astro.site ?? firma.sajt).href;
---

<Osnovni
  title="Tow Truck Belgrade 24/7 – Towing & Roadside Assistance | Šlep Stojanović"
  description="24/7 towing and roadside assistance near Belgrade: Zemun, New Belgrade, Batajnica, Pazova, airport area and the Belgrade–Novi Sad motorway. We speak English. WhatsApp +381 63 558 581."
  schema={[
    schemaFirma(),
    schemaUsluga('Towing and roadside assistance', 'Towing and roadside assistance 24/7 in the Belgrade area, Srem and on the Belgrade – Novi Sad motorway.', url, ['Belgrade', 'Srem', 'Serbia']),
    schemaPitanja(pitanja),
  ]}
>
  <HeroMali
    jezik="en"
    naslov="Tow truck & roadside assistance 24/7 – Belgrade area"
    podnaslov="Local towing company based in Stari Banovci, between Belgrade and Novi Sad, right next to the motorway. We speak English – call or send your location on WhatsApp."
    mrvice={[{ naziv: 'Home', url: '/en' }]}
  />

  <section class="sekcija">
    <div class="kontejner dve-kolone">
      <div>
        <h2 class="naslov-sekcije">What we do</h2>
        <div class="usluge-en">
          {
            usluge.map((u) => (
              <article class="kartica">
                <h3>{u.naziv}</h3>
                <p>{u.tekst}</p>
                {u.url && <a class="vise" href={u.url}>Read more →</a>}
              </article>
            ))
          }
        </div>
      </div>
      <div>
        <Image src={slike.automobil.src} alt="Car loaded on the flatbed of the Šlep Stojanović tow truck" widths={[480, 800]} sizes="(min-width: 860px) 45vw, 100vw" class="zaobljena" />
      </div>
    </div>
  </section>

  <section class="sekcija sekcija--siva">
    <div class="kontejner dve-kolone">
      <div>
        <h2 class="naslov-sekcije">Where we work</h2>
        <ul class="lista-tacke">
          {podrucje.map((p) => <li>{p}</li>)}
        </ul>
        <details class="sva-mesta-en">
          <summary>All places we cover</summary>
          {
            svaPodrucja.map((g) => (
              <p>
                <strong>{g.naslovEn}:</strong>{' '}
                {g.mesta
                  .map((m) => m.replace('ostali delovi Beograda', 'all other parts of Belgrade').replace(' (po dogovoru)', ' (by arrangement)'))
                  .join(', ')}
              </p>
            ))
          }
        </details>
        <p>
          On the motorway we most often work on the section from Belgrade through Batajnica and Pazova to Inđija –
          <a href="/en/highway-towing">highway & airport towing</a>.
        </p>
      </div>
      <iframe
        class="mapa-en"
        title="Map – Šlep Stojanović, Stari Banovci"
        src={firma.googleMapaEmbed(120000)}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </div>
  </section>

  <section class="sekcija">
    <div class="kontejner" style="max-width:820px">
      <h2 class="naslov-sekcije">How it works</h2>
      <ol class="lista-tacke">
        <li><strong>Call or message us</strong> – tell us where you are and what happened. Sharing your location on WhatsApp or Viber is the fastest.</li>
        <li><strong>Tell us the destination</strong> – a garage, your home, your hotel or any other address.</li>
        <li><strong>We load and transport</strong> – your vehicle goes on our flatbed and we take it where it needs to go.</li>
      </ol>
    </div>
  </section>

  <section class="sekcija sekcija--siva">
    <div class="kontejner" style="max-width:820px">
      <Faq pitanja={pitanja} naslov="Frequently asked questions" />
    </div>
  </section>

  <section class="sekcija" id="contact">
    <div class="kontejner" style="max-width:820px">
      <h2 class="naslov-sekcije">Contact</h2>
      <p class="telefon-en"><a href={firma.telefonLink}>{firma.telefonMedjunarodni}</a></p>
      <p>Phone, WhatsApp and Viber – 24/7, every day. E-mail: <a href={`mailto:${firma.email}`}>{firma.email}</a></p>
      <p>{firma.adresa.ulica}, {firma.adresa.postanskiBroj} {firma.adresa.mesto}, Serbia</p>
      <KontaktDugmad jezik="en" />
    </div>
  </section>

  <CtaTraka
    jezik="en"
    naslov="Broken down near Belgrade? Call now."
    tekst="We are available 24/7. Send your location on WhatsApp or Viber."
  />
</Osnovni>

<style>
  .usluge-en {
    display: grid;
    gap: 16px;
  }
  .sva-mesta-en {
    margin-bottom: 16px;
  }
  .sva-mesta-en summary {
    cursor: pointer;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .mapa-en {
    width: 100%;
    min-height: 340px;
    border: 0;
    border-radius: var(--radius);
  }
  .telefon-en {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 8px;
  }
  .telefon-en a {
    color: var(--crvena);
    text-decoration: none;
  }
</style>
