// Podešavanja za Cloudflare (Workers sa statičkim fajlovima).
// Sajt je potpuno statičan: Astro pravi folder dist/, Cloudflare ga servira.
{
  "name": "slepstojanovic",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
